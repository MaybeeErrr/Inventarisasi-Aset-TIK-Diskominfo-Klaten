# Salin file ini jadi ".env" untuk development lokal (opsional),
# lalu isi variabel di bawah. Untuk deployment, isi semuanya di
# Vercel Dashboard -> Project Settings -> Environment Variables.

# Connection string Neon Postgres (lihat langkah 1 di README.md)
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Kredensial login halaman /login.html — bebas diisi apa saja, ini BUKAN
# akun Google/email, hanya username & password sederhana untuk membatasi
# akses aplikasi ke pegawai Diskominfo saja.
AUTH_USERNAME=admin
AUTH_PASSWORD=ganti-dengan-password-yang-kuat

# String acak/rahasia untuk menandatangani cookie sesi login. Isi dengan
# teks acak yang panjang (mis. hasil dari `openssl rand -hex 32`). JANGAN
# dibagikan atau di-commit ke git.
AUTH_SECRET=ganti-dengan-string-acak-panjang
